{
  "name": "@chataoo/mobile",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8100",
    "build": "vite build",
    "cap:add": "cap add android",
    "cap:sync": "pnpm build && cap sync android",
    "cap:build:apk": "pnpm cap:sync && cd android && gradlew.bat -I ..\\gradle-init.gradle assembleDebug",
    "cap:open": "cap open android",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@chataoo/app-core": "workspace:*",
    "@chataoo/lan-socket": "workspace:*",
    "@chataoo/shared": "workspace:*",
    "@chataoo/ui": "workspace:*",
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.0"
  }
}
